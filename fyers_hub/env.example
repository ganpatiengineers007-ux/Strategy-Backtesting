# Is file ko ~/.fyers_hub/.env me copy karo (repo ke andar NAHI). Value yahan mat likho git me.
FYERS_APP_ID=
FYERS_SECRET_KEY=
# Fyers app me jo redirect URL register hai wahi yahan dalo
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html
# 4 ank ka Fyers PIN - sirf auto-refresh (15 din) ke liye, optional
FYERS_PIN=
# Fyers ki request limit (apne plan ke hisaab se)
FYERS_MAX_PER_SEC=5
FYERS_MAX_PER_MIN=50
# Risk-free rate (greeks ke liye), 0.07 = 7%
HUB_RISK_FREE_RATE=0.07
