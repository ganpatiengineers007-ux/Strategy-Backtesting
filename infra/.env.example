# infra/.env - docker compose ise padhta hai. Ise commit mat karo.
API_KEY=replace-with-32-plus-random-chars
CORS_ORIGINS=https://your-domain.example

# Login (python scripts/make_admin.py se generate karo)
ADMIN_USER=admin
# bcrypt hash me `$` hote hain; compose .env ke liye single quotes zaroori hain.
ADMIN_PASSWORD_HASH='$2b$12$replace_with_bcrypt_hash'

# Host ~/.fyers_hub (secrets read-only mount). Default: $HOME/.fyers_hub
# FYERS_HUB_HOST_DIR=/root/.fyers_hub

# TLS (only used by docker-compose.tls.yml; keep profile disabled until DNS + certs exist)
DOMAIN=your-domain.example
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
LOG_JSON=1
